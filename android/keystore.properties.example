# Copy to android/keystore.properties (git-ignored) to sign release builds with your own key.
# Make the key once:  keytool -genkeypair -v -keystore glowstick-release.jks -alias glowstick -keyalg RSA -keysize 2048 -validity 10000
# storeFile is relative to the android/ folder.
storeFile=glowstick-release.jks
storePassword=CHANGE_ME
keyAlias=glowstick
keyPassword=CHANGE_ME
